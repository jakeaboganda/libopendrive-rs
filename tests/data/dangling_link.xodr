<?xml version="1.0" encoding="UTF-8"?>
<!-- Links that point nowhere: a road-level successor naming a road that does
     not exist, and a lane-level successor naming a lane id absent from the
     target section. A dangling id in the connectivity graph would make the
     router walk to a lane it cannot look up. -->
<OpenDRIVE>
  <header revMajor="1" revMinor="7" name="dangling_link" version="1.00"/>
  <road name="a" length="40.0" id="1" junction="-1">
    <link>
      <successor elementType="road" elementId="404" contactPoint="start"/>
    </link>
    <planView>
      <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="40.0">
        <line/>
      </geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <center><lane id="0" type="none"/></center>
        <right>
          <lane id="-1" type="driving">
            <link><successor id="-99"/></link>
            <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
  <road name="b" length="40.0" id="2" junction="-1">
    <planView>
      <geometry s="0.0" x="100.0" y="0.0" hdg="0.0" length="40.0">
        <line/>
      </geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <center><lane id="0" type="none"/></center>
        <right>
          <lane id="-1" type="driving">
            <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
</OpenDRIVE>
