<?xml version="1.0" encoding="UTF-8"?>
<!-- A zero-length road (a real export artifact) alongside a good one. Baking
     it would produce a degenerate polyline: no direction, no length, and a
     trimesh the physics collider cannot build. -->
<OpenDRIVE>
  <header revMajor="1" revMinor="7" name="zero_length" version="1.00"/>
  <road name="degenerate" length="0.0" id="1" junction="-1">
    <planView>
      <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="0.0">
        <line/>
      </geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <center><lane id="0" type="none"/></center>
        <right>
          <lane id="-1" type="driving">
            <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
  <road name="good" length="40.0" id="2" junction="-1">
    <planView>
      <geometry s="0.0" x="100.0" y="0.0" hdg="0.0" length="40.0">
        <line/>
      </geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <center><lane id="0" type="none"/></center>
        <right>
          <lane id="-1" type="driving">
            <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
</OpenDRIVE>
